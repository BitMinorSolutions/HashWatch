{
  "name": "{{APP}}",
  "short_name": "{{APP}}",
  "description": "Live dashboard for your Avalon miner",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#08090b",
